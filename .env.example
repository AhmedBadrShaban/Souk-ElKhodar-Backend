NODE_ENV=development
PORT=4300
DATABASE_URL=postgresql://USER:PASSWORD@ep-example.neon.tech/neondb?sslmode=require
POSTGRES_PASSWORD=replace-for-local-docker
STOREFRONT_ORIGIN=https://storefront.example.com
DASHBOARD_ORIGIN=https://dashboard.example.com
BUSINESS_TIMEZONE=Africa/Cairo
PUBLIC_SITE_URL=https://storefront.example.com
PUBLIC_API_BASE_URL=/v1
# fixed is for local development only. twilio_whatsapp sends real codes to approved testers.
OTP_MODE=fixed
OTP_FIXED_CODE=123456
# To test with Twilio Sandbox, set OTP_MODE=twilio_whatsapp and fill these in your private .env.
OTP_TWILIO_ALLOWED_PHONES=+201000000000
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=replace-with-private-token
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_OTP_CONTENT_SID=HX00000000000000000000000000000000
# Development and test seed accounts only.
MOCK_ADMIN_PASSWORD=replace-for-local-demo
# Set a long random value before production. Changing it invalidates guest order links.
TRACKING_TOKEN_SECRET=replace-with-a-long-random-secret
# Product media uploads: backend-only Neon S3-compatible storage credentials.
AWS_ENDPOINT_URL_S3=https://YOUR-BRANCH.storage.YOUR-REGION.aws.neon.tech
AWS_ACCESS_KEY_ID=replace-with-new-key-id
AWS_SECRET_ACCESS_KEY=replace-with-new-secret
AWS_REGION=eu-central-1
S3_BUCKET=products
# One-time production owner bootstrap, supplied only while running bootstrap:owner:
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_BOOTSTRAP_NAME=
