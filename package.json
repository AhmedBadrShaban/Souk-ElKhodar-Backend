{
  "name": "souk-el-khodar-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "check": "tsc --noEmit",
    "smoke": "tsx src/smoke.ts",
    "bootstrap:owner": "tsx src/bootstrap-owner.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "express": "5.1.0",
    "multer": "^2.4.0",
    "pg": "8.16.3",
    "pino": "9.11.0",
    "sanitize-html": "2.18.1",
    "ws": "^8.22.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "24.7.2",
    "@types/pg": "8.15.5",
    "@types/sanitize-html": "2.16.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "htmlparser2": "10.1.0"
  }
}
